#7263=IFCPROPERTYSINGLEVALUE('Uitgangspunt 1',$,IFCTEXT('Verticale gebruikscombinaties \X2\03B3\X0\G\X2\00B7\X0\G + max(\X2\03B3\X0\Q\X2\00B7\X0\q, \X2\03B3\X0\Q\X2\00B7\X0\Q). Eigengewicht uit netto staalgeometrie, 7850 kg/m\X2\00B3\X0\. Voor BGT gelden karakteristieke lasten en E = 210000 N/mm\X2\00B2\X0\.'),$);
#7264=IFCPROPERTYSINGLEVALUE('Uitgangspunt 2',$,IFCTEXT('Rekenmodel met scharnierende neerwaartse opleggingen. Afzonderlijke controles op kip, plooien, lokale belasting, horizontale stabiliteit en dynamica staan bij de betreffende onderdelen.'),$);
#7265=IFCPROPERTYSINGLEVALUE('Uitgangspunt 3',$,IFCTEXT('De ankerinvoer is een UGT-omhullende voor alle voeten in lokale plaatassen. N is externe trek na bepaling van de oplegreacties. Geef momenten en horizontale kracht als absolute waarden op.'),$);
