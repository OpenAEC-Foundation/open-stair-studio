{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Stair Studio",
  "version": "0.13.16",
  "identifier": "org.openaec.open-stair-studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Open Stair Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": { "nsis": { "installMode": "currentUser" } },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3QUQ0RDE3OUYzQTYxQ0EKUldUS1lUcWZGMDJ0eDRRT2RLN0l5RzdZWGdqV2Zua0EyVmVEaUhXSE1hUEFnU0hmL1pKbWczaEMK",
      "endpoints": ["https://github.com/OpenAEC-Foundation/open-stair-studio/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
